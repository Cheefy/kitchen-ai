# Postgres runs as its own standalone Unraid container, not as part of this
# Compose stack -- see kitchen_ai_spec.md §2. Replace <UNRAID_LAN_IP> with
# the Unraid box's actual LAN IP (or a local hostname if you have one, e.g.
# tower.local) and the password with what you set in that container's
# POSTGRES_PASSWORD.
DATABASE_URL=postgresql+asyncpg://kitchenai:changeme@<UNRAID_LAN_IP>:5433/kitchenai

# llama.cpp server (server-vulkan, running on the Arc Pro B70) -- also
# standalone, not part of this Compose stack. Exposes an OpenAI-compatible
# API under /v1.
LLM_BASE_URL=http://<UNRAID_LAN_IP>:8081/v1

# Pushover (kitchen_ai_spec.md §10) -- API Token from a registered
# Application on pushover.net, User Key from your account dashboard.
# Neither is your Pushover login -- both are safely shareable/revocable
# without touching account access.
PUSHOVER_API_TOKEN=changeme
PUSHOVER_USER_KEY=changeme

# Garmin Connect (kitchen_ai_spec.md §9) -- run scripts/garmin_login.py
# once (interactively, so it can handle MFA if your account has it) to
# create the session tokenstore before this matters. Once that exists,
# the backend resumes from it and doesn't actually need a real password
# here -- verified directly: a resume succeeded even with a deliberately
# wrong password once tokens existed. These two are only a fallback for
# that resume failing, and MFA can't be completed headlessly anyway, so
# a wrong/placeholder password here is fine day-to-day.
GARMIN_EMAIL=changeme
GARMIN_PASSWORD=changeme
GARMIN_TOKENSTORE=/data/garmin_tokens
